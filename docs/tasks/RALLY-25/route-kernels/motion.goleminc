    lap = lapInput
    contactAny = false
    For slot In Range(0:5)
        activeChecked = active(slot)
        contacts(slot) = 0
        If activeChecked == 1 Then
            progress(slot) = progress(slot) + sint32(forwardAdvance)
            work = sint32(position(slot)) + sint32(forwardAdvance)
            (quotient,remainder) = divmod(work,lap)
            If remainder < 0 Then
                remainder = remainder + lap
            EndIf
            position(slot) = uint32(remainder)
            (laneQuotient,laneRemainder) = divmod(slot,3)
            placedLateral = (sint32(laneRemainder) - 1) * 9216
            (laneQuotient,laneRemainder) = divmod(slot,2)
            If laneRemainder == 0 Then
                placedLateral = placedLateral + routeLateral - 5044
            Else
                placedLateral = placedLateral - routeLateral + 5044
            EndIf
            lateral(slot) = placedLateral
            opponentStation = position(slot)
            opponentLateral = lateral(slot)
@CONTACT@
            If contactResult Then
                contacts(slot) = 1
                contactAny = true
            EndIf
        EndIf
    Next slot
    worldTick = worldTick + 1
