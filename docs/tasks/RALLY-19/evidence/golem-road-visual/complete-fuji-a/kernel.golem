Program setPainted(2009) { Set(painted,1); };
Program kerbGeometry(2020) {
    MatLoad(cxTopMatrix,cxTop); MatLoad(cxBottomMatrix,cxBottom); MatLoad(widthTopMatrix,widthTop); MatLoad(widthBottomMatrix,widthBottom);
    MatScale(offsetMatrix,widthTopMatrix,-106); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(leftTop,xMatrix);
    MatScale(offsetMatrix,widthTopMatrix,106); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(rightTop,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,-106); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(leftBottom,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,106); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(rightBottom,xMatrix);
};
Program roadGeometry(2021) {
    MatLoad(cxTopMatrix,cxTop); MatLoad(cxBottomMatrix,cxBottom); MatLoad(widthTopMatrix,widthTop); MatLoad(widthBottomMatrix,widthBottom);
    MatScale(offsetMatrix,widthTopMatrix,-90); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(leftTop,xMatrix);
    MatScale(offsetMatrix,widthTopMatrix,90); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(rightTop,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,-90); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(leftBottom,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,90); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(rightBottom,xMatrix);
};
Program leftShoulderGeometry(2022) {
    MatLoad(cxTopMatrix,cxTop); MatLoad(cxBottomMatrix,cxBottom); MatLoad(widthTopMatrix,widthTop); MatLoad(widthBottomMatrix,widthBottom);
    MatScale(offsetMatrix,widthTopMatrix,-86); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(leftTop,xMatrix);
    MatScale(offsetMatrix,widthTopMatrix,-84); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(rightTop,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,-86); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(leftBottom,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,-84); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(rightBottom,xMatrix);
};
Program rightShoulderGeometry(2023) {
    MatLoad(cxTopMatrix,cxTop); MatLoad(cxBottomMatrix,cxBottom); MatLoad(widthTopMatrix,widthTop); MatLoad(widthBottomMatrix,widthBottom);
    MatScale(offsetMatrix,widthTopMatrix,84); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(leftTop,xMatrix);
    MatScale(offsetMatrix,widthTopMatrix,86); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(rightTop,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,84); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(leftBottom,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,86); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(rightBottom,xMatrix);
};
Program centrelineGeometry(2024) {
    MatLoad(cxTopMatrix,cxTop); MatLoad(cxBottomMatrix,cxBottom); MatLoad(widthTopMatrix,widthTop); MatLoad(widthBottomMatrix,widthBottom);
    MatScale(offsetMatrix,widthTopMatrix,-2); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(leftTop,xMatrix);
    MatScale(offsetMatrix,widthTopMatrix,2); MatAdd(xMatrix,cxTopMatrix,offsetMatrix); StoreI16Floor(rightTop,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,-2); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(leftBottom,xMatrix);
    MatScale(offsetMatrix,widthBottomMatrix,2); MatAdd(xMatrix,cxBottomMatrix,offsetMatrix); StoreI16Floor(rightBottom,xMatrix);
};
Program redQuad(2030) { PlotQuad(9,leftTop,yTop,rightTop,yTop,leftBottom,yBottom,rightBottom,yBottom); };
Program whiteQuad(2031) { PlotQuad(15,leftTop,yTop,rightTop,yTop,leftBottom,yBottom,rightBottom,yBottom); };
Program greyQuad(2032) { PlotQuad(8,leftTop,yTop,rightTop,yTop,leftBottom,yBottom,rightBottom,yBottom); };
Program yellowQuad(2033) { PlotQuad(11,leftTop,yTop,rightTop,yTop,leftBottom,yBottom,rightBottom,yBottom); };
Program drawPainted(2040) {
    Call(kerbGeometry); Call(redQuad); Call(roadGeometry); Call(greyQuad);
    Call(leftShoulderGeometry); Call(yellowQuad); Call(rightShoulderGeometry); Call(yellowQuad);
    Call(centrelineGeometry); Call(yellowQuad);
};
Program drawWhite(2041) {
    Call(kerbGeometry); Call(whiteQuad); Call(roadGeometry); Call(greyQuad);
    Call(leftShoulderGeometry); Call(whiteQuad); Call(rightShoulderGeometry); Call(whiteQuad);
};

Buffer bankSelection(1530,8);
Field bankNumber(bankSelection,0,u16,0,1); Field bankRecord(bankSelection,2,u16,0,286);
