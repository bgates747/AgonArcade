// R19-05 stock-VDP admission proof; renderProof is replaced in later milestones.
// This source is compiled by existing C++ Golem, with no host-rendered geometry.
// Source bounds are admitted at submit; staging seal is cleared after every call.
Buffer staging(1000,80);
Field version(staging,0,u16,1,1);
Field size(staging,2,u16,80,80);
Field seq(staging,4,u16,0,65534);
Field track(staging,6,u16,0,1);
Field position(staging,8,s32,0,3276799);
Field phase(staging,12,u16,0,7999);
Field steering(staging,14,s16,-21,21);
Field lateral(staging,16,s32,-38400,38400);
Field speed(staging,20,u16,0,300);
Field surface(staging,22,u16,0,2);
Field car0Position(staging,24,s32,0,3276799);
Field car0Lane(staging,28,s16,-90,90);
Field car0Reserved(staging,30,u16,0,0);
Field car1Position(staging,32,s32,0,3276799);
Field car1Lane(staging,36,s16,-90,90);
Field car1Reserved(staging,38,u16,0,0);
Field car2Position(staging,40,s32,0,3276799);
Field car2Lane(staging,44,s16,-90,90);
Field car2Reserved(staging,46,u16,0,0);
Field car3Position(staging,48,s32,0,3276799);
Field car3Lane(staging,52,s16,-90,90);
Field car3Reserved(staging,54,u16,0,0);
Field car4Position(staging,56,s32,0,3276799);
Field car4Lane(staging,60,s16,-90,90);
Field car4Reserved(staging,62,u16,0,0);
Field car5Position(staging,64,s32,0,3276799);
Field car5Lane(staging,68,s16,-90,90);
Field car5Reserved(staging,70,u16,0,0);
Field flags(staging,72,u16,0,7);
Field grip(staging,74,u16,25,200);
Field seqCopy(staging,76,u16,0,65534);
Field seal(staging,78,u16,0,65535);
Buffer active(1001,80);
Field activeversion(active,0,u16,1,1);
Field activesize(active,2,u16,80,80);
Field activeseq(active,4,u16,0,65534);
Field activetrack(active,6,u16,0,1);
Field activeposition(active,8,s32,0,3276799);
Field activephase(active,12,u16,0,7999);
Field activesteering(active,14,s16,-21,21);
Field activelateral(active,16,s32,-38400,38400);
Field activespeed(active,20,u16,0,300);
Field activesurface(active,22,u16,0,2);
Field activecar0Position(active,24,s32,0,3276799);
Field activecar0Lane(active,28,s16,-90,90);
Field activecar0Reserved(active,30,u16,0,0);
Field activecar1Position(active,32,s32,0,3276799);
Field activecar1Lane(active,36,s16,-90,90);
Field activecar1Reserved(active,38,u16,0,0);
Field activecar2Position(active,40,s32,0,3276799);
Field activecar2Lane(active,44,s16,-90,90);
Field activecar2Reserved(active,46,u16,0,0);
Field activecar3Position(active,48,s32,0,3276799);
Field activecar3Lane(active,52,s16,-90,90);
Field activecar3Reserved(active,54,u16,0,0);
Field activecar4Position(active,56,s32,0,3276799);
Field activecar4Lane(active,60,s16,-90,90);
Field activecar4Reserved(active,62,u16,0,0);
Field activecar5Position(active,64,s32,0,3276799);
Field activecar5Lane(active,68,s16,-90,90);
Field activecar5Reserved(active,70,u16,0,0);
Field activeflags(active,72,u16,0,7);
Field activegrip(active,74,u16,25,200);
Field activeseqCopy(active,76,u16,0,65534);
Field activeseal(active,78,u16,0,65535);
Buffer status(1002,10);
Field valid(status,0,u16,0,1);
Field wrap(status,2,u16,0,1);
Field acceptedCount(status,4,u16);
Field lastSequence(status,6,u16);
Field error(status,8,u16,0,1);
Buffer sequenceState(1003,2);
Field expectedSequence(sequenceState,0,u16);
Buffer constants(1004,6);
Field zero(constants,0,u16,0,0);
Field one(constants,2,u16,1,1);
Field loadedTrack(constants,4,u16,0,1);
Set(one,1);
Set(loadedTrack,1); // Recompile/load 1 for Fuji; payload alone cannot switch tracks.
Matrix inputPosition(1100,1,1);
Matrix proofResult(1102,1,1);
Program submit(2000) {
    Set(valid,1);
    Set(error,1);
    RequireRange(version,valid);
    RequireRange(size,valid);
    RequireRange(seq,valid);
    RequireRange(track,valid);
    RequireRange(position,valid);
    RequireRange(phase,valid);
    RequireRange(steering,valid);
    RequireRange(lateral,valid);
    RequireRange(speed,valid);
    RequireRange(surface,valid);
    RequireRange(car0Position,valid);
    RequireRange(car0Lane,valid);
    RequireRange(car0Reserved,valid);
    RequireRange(car1Position,valid);
    RequireRange(car1Lane,valid);
    RequireRange(car1Reserved,valid);
    RequireRange(car2Position,valid);
    RequireRange(car2Lane,valid);
    RequireRange(car2Reserved,valid);
    RequireRange(car3Position,valid);
    RequireRange(car3Lane,valid);
    RequireRange(car3Reserved,valid);
    RequireRange(car4Position,valid);
    RequireRange(car4Lane,valid);
    RequireRange(car4Reserved,valid);
    RequireRange(car5Position,valid);
    RequireRange(car5Lane,valid);
    RequireRange(car5Reserved,valid);
    RequireRange(flags,valid);
    RequireRange(grip,valid);
    RequireRange(seqCopy,valid);
    RequireRange(seal,23065,23065,valid);
    RequireEqual(seq,seqCopy,valid);
    RequireEqual(seq,expectedSequence,valid);
    RequireEqual(track,loadedTrack,valid);
    CallIf(ovalBounds,track,eq,zero);
    CallIf(commitState,valid,eq,one);
    Set(seal,0);
};
Program ovalBounds(2001) {
    RequireRange(position,0,575999,valid);
    RequireRange(car0Position,0,575999,valid);
    RequireRange(car1Position,0,575999,valid);
    RequireRange(car2Position,0,575999,valid);
    RequireRange(car3Position,0,575999,valid);
    RequireRange(car4Position,0,575999,valid);
    RequireRange(car5Position,0,575999,valid);
};
Program commitState(2002) {
    CopyRecord(active,staging);
    Call(renderProof);
    AddU16(acceptedCount,1);
    Copy(lastSequence,seq,2);
    Copy(expectedSequence,seq,2);
    AddU16(expectedSequence,1);
    Set(wrap,1);
    RequireRange(expectedSequence,0,65534,wrap);
    CallIf(resetSequence,wrap,eq,zero);
    Set(error,0);
};
Program resetSequence(2003) { Set(expectedSequence,0); };
Program renderProof(2004) {
    MatLoad(inputPosition,activeposition);
    MatScale(proofResult,inputPosition,2);
};
