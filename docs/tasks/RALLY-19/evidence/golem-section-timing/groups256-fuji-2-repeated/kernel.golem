    MatMul(dTerm,dFloat,fractionUnit);
    MatTrunc(truncated,dTerm); MatLoad(dTerm,truncatedValue);
    MatMul(eTerm,eFloat,squareUnit);
    MatTrunc(truncated,eTerm); MatLoad(eTerm,truncatedValue);
