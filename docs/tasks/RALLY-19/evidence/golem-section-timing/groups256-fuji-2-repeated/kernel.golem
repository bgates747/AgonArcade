Field curveBands2033lo(curveBands,8132,u16,104,223);
Field curveBands2033hi(curveBands,8134,u16,105,224);
Field curveBands2034lo(curveBands,8136,u16,104,223);
Field curveBands2034hi(curveBands,8138,u16,105,224);
Field curveBands2035lo(curveBands,8140,u16,104,223);
Field curveBands2035hi(curveBands,8142,u16,105,224);
Field curveBands2036lo(curveBands,8144,u16,104,223);
