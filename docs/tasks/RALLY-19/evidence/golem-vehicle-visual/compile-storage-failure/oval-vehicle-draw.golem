    MatLoad(road_rowTopMatrix,road_yTop); MatLoad(road_rowBottomMatrix,road_yBottom);
    MatAdd(road_qTopMatrix,road_rowTopMatrix,road_minus96);
    MatAdd(road_qBottomMatrix,road_rowBottomMatrix,road_minus96);
    MatScale(road_widthTopMatrix,road_qTopMatrix,0.02); MatScale(road_widthBottomMatrix,road_qBottomMatrix,0.02);
    Copy(road_widthTop,road_readWidthTop,4); Copy(road_widthBottom,road_readWidthBottom,4);
