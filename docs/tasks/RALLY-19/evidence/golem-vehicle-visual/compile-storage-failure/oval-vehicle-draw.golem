Program road_kerbGeometry(2420) {
    MatLoad(road_cxTopMatrix,road_cxTop); MatLoad(road_cxBottomMatrix,road_cxBottom); MatLoad(road_widthTopMatrix,road_widthTop); MatLoad(road_widthBottomMatrix,road_widthBottom);
    MatScale(road_offsetMatrix,road_widthTopMatrix,-106); MatAdd(road_xMatrix,road_cxTopMatrix,road_offsetMatrix); StoreI16Floor(road_leftTop,road_xMatrix);
    MatScale(road_offsetMatrix,road_widthTopMatrix,106); MatAdd(road_xMatrix,road_cxTopMatrix,road_offsetMatrix); StoreI16Floor(road_rightTop,road_xMatrix);
    MatScale(road_offsetMatrix,road_widthBottomMatrix,-106); MatAdd(road_xMatrix,road_cxBottomMatrix,road_offsetMatrix); StoreI16Floor(road_leftBottom,road_xMatrix);
    MatScale(road_offsetMatrix,road_widthBottomMatrix,106); MatAdd(road_xMatrix,road_cxBottomMatrix,road_offsetMatrix); StoreI16Floor(road_rightBottom,road_xMatrix);
};
Program road_roadGeometry(2421) {
    MatLoad(road_cxTopMatrix,road_cxTop); MatLoad(road_cxBottomMatrix,road_cxBottom); MatLoad(road_widthTopMatrix,road_widthTop); MatLoad(road_widthBottomMatrix,road_widthBottom);
    MatScale(road_offsetMatrix,road_widthTopMatrix,-90); MatAdd(road_xMatrix,road_cxTopMatrix,road_offsetMatrix); StoreI16Floor(road_leftTop,road_xMatrix);
    MatScale(road_offsetMatrix,road_widthTopMatrix,90); MatAdd(road_xMatrix,road_cxTopMatrix,road_offsetMatrix); StoreI16Floor(road_rightTop,road_xMatrix);
