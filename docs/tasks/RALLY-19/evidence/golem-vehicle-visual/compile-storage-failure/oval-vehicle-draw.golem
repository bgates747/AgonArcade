Program road_prepareProjection(2405) {
    DivModPositive(road_interval,road_local,activeposition,6400);
    LoadElement(road_intervalData,road_coeffBank0,road_interval,road_intervalOK);
    WidenUnsigned(road_localWide,road_local);
