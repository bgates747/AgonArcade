Program road_redQuad(2430) { PlotQuad(9,road_leftTop,road_yTop,road_rightTop,road_yTop,road_leftBottom,road_yBottom,road_rightBottom,road_yBottom); };
Program road_whiteQuad(2431) { PlotQuad(15,road_leftTop,road_yTop,road_rightTop,road_yTop,road_leftBottom,road_yBottom,road_rightBottom,road_yBottom); };
