    StoreU16Floor(road_rowIndex,road_rowMinus103);
    LoadElement(road_selectedDepth,road_depths,road_rowIndex,road_depthOK);
    MatLoad(road_depthFloat,road_depth);
    MatAdd(road_aheadFloat,road_fraction14Float,road_depthFloat);
    MatScale(road_aheadScaled,road_aheadFloat,0.00006103515625);
    StoreU16Floor(road_aheadIndex,road_aheadScaled);
    LoadElement(road_coefficient,road_intervalData,road_aheadIndex,road_coefficientOK);
    Copy(road_outa,road_a,2); Copy(road_outb,road_b,2); Copy(road_outc,road_c,4); Copy(road_outd,road_d,2); Copy(road_oute,road_e,2);
    MatLoad(road_aFloat,road_a); MatLoad(road_bFloat,road_b); MatLoad(road_cFloat,road_c); MatLoad(road_dFloat,road_d); MatLoad(road_eFloat,road_e);
    MatMul(road_bTerm,road_bFloat,road_fractionUnit);
    MatTrunc(road_truncated,road_bTerm); MatLoad(road_bTerm,road_truncatedValue);
    MatMul(road_dTerm,road_dFloat,road_fractionUnit);
    MatTrunc(road_truncated,road_dTerm); MatLoad(road_dTerm,road_truncatedValue);
    MatMul(road_eTerm,road_eFloat,road_squareUnit);
    MatTrunc(road_truncated,road_eTerm); MatLoad(road_eTerm,road_truncatedValue);
    MatScale(road_aTerm,road_aFloat,4);
    MatAdd(road_lineA,road_aTerm,road_bTerm);
    MatAdd(road_lineBPart,road_cFloat,road_dTerm);
    MatAdd(road_lineB,road_lineBPart,road_eTerm);
    MatAdd(road_qFloat,road_rowFloat,road_minus96);
    MatMul(road_rowSlope,road_lineB,road_qFloat);
