    StoreU16Floor(road_fraction14,road_fractionFloat);
    WidenUnsigned(road_fraction14Wide,road_fraction14);
    MatLoad(road_fraction14Float,road_fraction14Wide);
    MatScale(road_fractionFloat,road_fraction14Float,0.25);
    StoreU16Floor(road_fraction12,road_fractionFloat);
    WidenUnsigned(road_fraction12Wide,road_fraction12);
    MatLoad(road_fraction12Float,road_fraction12Wide);
    MatMul(road_squareFloat,road_fraction12Float,road_fraction12Float);
    MatScale(road_squareDivided,road_squareFloat,0.000244140625);
    StoreU16Floor(road_square12,road_squareDivided);
    WidenUnsigned(road_squareWide,road_square12);
    MatLoad(road_squareFloat,road_squareWide);
    MatScale(road_fractionUnit,road_fraction12Float,0.000244140625);
    MatScale(road_squareUnit,road_squareFloat,0.000244140625);
